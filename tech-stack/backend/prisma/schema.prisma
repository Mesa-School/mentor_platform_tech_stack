// Prisma is used for SCHEMA + MIGRATIONS ONLY.
// There is no prisma-client generator — the app never imports Prisma Client at runtime.
// `prisma-kysely` emits the typed `DB` interface in src/core/db/types.ts that Kysely uses.
//
// Workflow:
//   npm run db:migrate -- --name <change>   create + apply a migration in dev (regenerates types)
//   npm run db:deploy                        apply pending migrations in CI/prod
//
// What lives here by default is INFRASTRUCTURE only: the identity row every service needs
// and the audit trail. Feature tables belong to their vertical slice — add them below as the
// slice is built, and keep not-yet-built ones as commented stubs so the model stays visible.

// Prisma 7: the connection URL lives in prisma.config.ts, not here.
datasource db {
  provider = "postgresql"
}

generator kysely {
  provider     = "prisma-kysely"
  output       = "../src/core/db"
  fileName     = "types.ts"
  enumFileName = "enums.ts"
  // The project is ESM/NodeNext, so generated relative imports need the .js extension.
  importExtension = ".js"
  banner          = "// GENERATED by prisma-kysely - DO NOT EDIT. Regenerate with: npm run db:generate"
}

// NOTE ON DEFAULTS: `@default(uuid())` and `@updatedAt` are Prisma *Client* behaviours, and
// this project never runs the Prisma Client. Every default therefore has to exist in the
// database itself - hence `dbgenerated("gen_random_uuid()")` on ids and `@default(now())` on
// updatedAt. If you add a model, do the same, or raw-SQL inserts will fail on NOT NULL.

// ---------------------------------------------------------------------------
// Roles — the RBAC vocabulary. Rename/extend to fit the domain; keep ADMIN last.
// ---------------------------------------------------------------------------
enum Role {
  USER
  MANAGER
  ADMIN
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------
model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  departmentId String?  @db.Uuid
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  // NOTE: `@updatedAt` is a Prisma *Client* behaviour and this project never runs the Prisma
  // Client — so the column also gets a DB default, and repositories set it explicitly on every
  // UPDATE (`set({ ...patch, updatedAt: new Date() })`). For a belt-and-braces guarantee, add a
  // trigger by hand in the generated migration:
  //   CREATE OR REPLACE FUNCTION set_updated_at() RETURNS trigger AS $$
  //     BEGIN NEW."updatedAt" = now(); RETURN NEW; END $$ LANGUAGE plpgsql;
  //   CREATE TRIGGER user_set_updated_at BEFORE UPDATE ON "User"
  //     FOR EACH ROW EXECUTE FUNCTION set_updated_at();
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([role])
  @@index([departmentId])
}

// ---------------------------------------------------------------------------
// Audit trail — written inside the same transaction as the change it records.
// ---------------------------------------------------------------------------
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType String
  entityId   String   @db.Uuid
  action     String
  actorId    String?  @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

