# Copy to .env and fill in. Validated by src/core/config at boot — bad values crash the process.
NODE_ENV=development
PORT=4000

# Service identity. These two drive EVERY user-visible name: the landing page, the /health
# dashboard, the Swagger and Redoc titles, the OpenAPI document and the auth realm. Renaming a
# service means editing these, not hunting through templates. Version comes from package.json.
SERVICE_NAME=My Service
SERVICE_DESCRIPTION=A typed REST API over PostgreSQL.

# Postgres. Local docker-compose by default; for a managed instance use a full URL and set
# DB_SSL. URL-encode special characters in the password (@ -> %40, ! -> %21, # -> %23).
#   DATABASE_URL=postgresql://user:p%40ssword@host:5432/dbname?schema=public&sslmode=require
DATABASE_URL=postgresql://app:app@localhost:5432/app?schema=public

# disable | require | verify-full. Managed Postgres needs at least `require`.
# `verify-full` additionally needs DB_SSL_CA=/path/to/server-ca.pem and is the only mode
# that actually protects against a man-in-the-middle.
DB_SSL=disable
# DB_SSL_CA=

# WARNING: the test suite TRUNCATEs every table in this database before each test.
# It must always point at a throwaway local database, never at a shared or managed one.
TEST_DATABASE_URL=postgresql://app:app@localhost:5432/app_test?schema=public

DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000

# Auth — generate each with: npm run prepare:env
JWT_ACCESS_SECRET=change-me-min-32-chars-long-secret-value-000
JWT_REFRESH_SECRET=change-me-different-min-32-chars-secret-000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# CORS — comma-separated allowlist (no trailing slash)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting (per IP, per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# HTTP Basic credentials for /docs, /redoc, /openapi.json and the /health dashboard.
# Leave blank in development to browse them freely. In PRODUCTION, docs are not mounted at all
# unless both are set — an unauthenticated map of every endpoint is a gift to an attacker.
DOCS_USERNAME=
DOCS_PASSWORD=

# Storage (local disk adapter in dev)
STORAGE_DIR=var/uploads

LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# Optional integrations. Each one stays OFF until its credentials are present,
# so the service runs fine without an AWS, Azure or Google account. Check the
# exported flags (gcsEnabled / sesEnabled / azureChatEnabled / geminiEnabled)
# rather than reading these variables directly.
# ─────────────────────────────────────────────────────────────────────────────

# Google Cloud Storage. Leave GCS_SERVICE_ACCOUNT_PATH unset on App Engine —
# the runtime service account (Application Default Credentials) is used instead,
# and a key file on disk would be a liability.
GCS_BUCKET_NAME=
GCS_BUCKET_PREFIX=
GCS_PROJECT_ID=
# GCS_SERVICE_ACCOUNT_PATH=
# true = browser PUTs straight to GCS via a presigned URL. Needs the runtime SA to
# hold roles/iam.serviceAccountTokenCreator on itself and bucket CORS to allow PUT.
GCS_USE_SIGNED_URLS=false
GCS_SIGNED_URL_EXPIRATION=3600

# AWS SES (transactional email)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=

# Azure OpenAI (chat). BASE_URL must end in a slash. DEPLOYMENT is an Azure
# deployment name, never a model id.
AZURE_OPENAI_CHAT_BASE_URL=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_CHAT_API_KEY=

# Gemini via its OpenAI-compatible endpoint, so the same SDK works. Trailing slash matters.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.7-flash
GEMINI_API_KEY=
